<?xml version="1.0" ?>
<!--
  Top-level URDF for the real ANTBot hardware platform.
  Combines the shared core (antbot_core.xacro) with the real-hardware
  ros2_control interface (ros2_control.xacro).

  For the Gazebo simulation variant, see antbot_gazebo/urdf/antbot_sim.xacro.
-->
<robot name="antbot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find antbot_description)/urdf/antbot_core.xacro"/>
  <xacro:include filename="$(find antbot_description)/urdf/ros2_control.xacro"/>

  <xacro:AntbotCore/>
  <xacro:AntbotRos2Control/>

</robot>
