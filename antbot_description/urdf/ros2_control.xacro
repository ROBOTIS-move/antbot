<?xml version="1.0"?>
<!--
  ros2_control hardware interface definition for the base platform.
  Controls 8 joints via the ANTBot BoardInterface plugin.

  Joint configuration:
    - 4 drive joints (wheel_*_joint):    velocity/acceleration command, velocity/position/effort feedback
    - 4 steering joints (steering_*_joint): position/velocity/acceleration command, position/effort feedback
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="AntbotRos2Control">
    <ros2_control name="base_hardware" type="system">
      <hardware>
        <plugin>antbot/hw_interface/BoardInterface</plugin>
      </hardware>

      <!-- === Drive (Wheel) joints: velocity control === -->
      <!-- Controls each wheel's rotational velocity to drive the robot -->
      <joint name="wheel_front_left_joint">
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="position"/>
      </joint>
      <joint name="wheel_front_right_joint">
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="position"/>
      </joint>
      <joint name="wheel_rear_left_joint">
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="position"/>
      </joint>
      <joint name="wheel_rear_right_joint">
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="position"/>
      </joint>

      <!-- === Steering joints: position control === -->
      <!-- Controls each wheel's heading angle for steering -->
      <joint name="steering_front_left_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="steering_front_right_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="steering_rear_left_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="steering_rear_right_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>
