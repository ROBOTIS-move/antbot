<?xml version="1.0" ?>
<!--
  2D LiDAR module.
  Defines a reusable macro for a single 2D planar LiDAR sensor.
  Passing a calibration key enables YAML file-based position override.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    Lidar2d: Creates one 2D LiDAR.
    @param name             Sensor name (e.g., lidar_2d_front)
                            Generated: {name}_link
    @param parent           Exact parent link name (e.g., "base_link")
    @param xyz              Position relative to parent [m]
    @param rpy              Orientation relative to parent [rad]
    @param calibration_key  (optional) YAML calibration key. If empty, xyz/rpy are used.
  -->
  <xacro:macro name="Lidar2d" params="name parent xyz rpy calibration_key:=''">
    <xacro:CalibratedSensorFrame name="${name}" parent="${parent}"
      default_xyz="${xyz}" default_rpy="${rpy}"
      calibration_key="${calibration_key}"/>
  </xacro:macro>

</robot>
